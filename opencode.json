{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".claude/skills"]
  },
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ohczlooperjqpyllmabo&read_only=true",
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "oauth": false,
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@playwright/mcp@0.0.83"],
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "graphify.serve",
        "C:\\Users\\saras\\.graphify\\school-website\\graph.json"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
